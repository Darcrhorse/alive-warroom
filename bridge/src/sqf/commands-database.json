  },
  "forbiddenCommands": [
    "endMission",
    "failMission",
    "forceEnd",
    "terminate",
    "exitWith",
    "serverCommand",
    "admin",
    "saveProfileNamespace",
    "loadFile",
    "preprocessFile",
    "deleteVehicle player",
    "player setDamage 1"
  ]
}
